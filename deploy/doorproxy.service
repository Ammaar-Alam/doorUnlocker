[Unit]
Description=Door Unlocker Caddy reverse proxy
Wants=network-online.target
After=network-online.target doorunlocker.service

[Service]
Type=notify
User=doorproxy
Group=doorproxy
WorkingDirectory=/var/lib/doorproxy
Environment=XDG_DATA_HOME=/var/lib/doorproxy
Environment=XDG_CONFIG_HOME=/var/lib/doorproxy
ExecStart=/usr/local/bin/caddy run --config /etc/doorproxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
SyslogIdentifier=doorproxy

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

MemoryHigh=128M
MemoryMax=192M
CPUQuota=20%
TasksMax=64
LimitNOFILE=8192
UMask=0077

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/doorproxy
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
